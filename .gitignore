# Rust build artifacts
/target

# Nix build symlink
/result

# Generated intermediate data (analysis output — never committed)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Harvested Claude Code session data MUST NOT be committed.
# Test fixtures live under tests/ and are synthetic — see
# .claude/rules/session-data-privacy.md. Anything captured from a real
# ~/.claude/projects transcript belongs only in a local scratch dir.
/scratch
/.scratch
*.jsonl
!tests/**/*.jsonl

# OS / editor noise
.DS_Store

# Private input, configuration and derived exports
/logs
/exports
*.log
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal
auth.json
credentials.json
.env
.env.*
!.env.example
